# Copie para .env (que fica fora do git) só se quiser mudar os padrões. Nada aqui é obrigatório.
# O app lê este arquivo ao iniciar; variáveis já definidas no ambiente têm prioridade.

# Banco SQLite local (padrão: dados/benchmark.db)
BENCH_DB=
# Pasta com os relatorio.json (padrão: relatorios/)
BENCH_RELATORIOS=
# Chave do Firebase Admin do projeto juizdebocha (padrão: credenciais/firebase-admin.json).
# Coloque aqui só o CAMINHO do arquivo — nunca cole o conteúdo da chave no repositório.
BENCH_FIREBASE_CRED=
